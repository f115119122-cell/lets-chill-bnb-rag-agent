# Copy this file to .env and put your own key after API_KEY=
# Never upload .env to GitHub.

# ============================================================
# PART 1. Chat model: writes the answers (must support tool calling)
# ============================================================

## NKUST (key: https://www.iai.nkust.edu.tw/ , sign in with your NKUST Google account)
LLM_API_URL=https://www.iai.nkust.edu.tw/aihub/v1/
MODEL_NAME=Furen-large
API_KEY=

## Gemini
# LLM_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# MODEL_NAME=gemini-3.5-flash-lite
# API_KEY=

# ============================================================
# PART 2. Embedding model: turns text into numbers for the RAG search
# Leave these empty to use the chat model's server and key (works for NKUST).
# ============================================================

## NKUST (the embedding model name starts with a capital E)
EMBEDDING_API_URL=
EMBEDDING_MODEL_NAME=Embedding
EMBEDDING_API_KEY=

## Gemini
# EMBEDDING_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# EMBEDDING_MODEL_NAME=gemini-embedding-001
# EMBEDDING_API_KEY=
